{
  "enabled": true,
  "name": "Figma Component Code Connect",
  "description": "Check if UI component should be connected to Figma design when Flutter widget files are modified",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "lib/app/widgets/*.dart",
      "lib/app/view/**/*.dart",
      "**/*widget*.dart"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "When a Flutter widget file is created or updated, ask the user if they would like to connect this component to a Figma design. If the user approves: first ask them to provide the Figma URL if not already available, then run the get_code_connect_map tool for that URL. If the response is empty, run the add_code_connect_map tool to create the connection, otherwise tell the user they already have code mapped to that component. If the user rejects: Do not run any additional tools."
  }
}