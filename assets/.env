# ─── Firebase Phone Auth Configuration ──────────────────────
# Firebase Auth Emulator (PC IP on physical device, 10.0.2.2 on Android emulator)
# Uncomment for local emulator testing:
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1
# FIREBASE_AUTH_EMULATOR_PORT=9099

# reCAPTCHA Flow Settings:
# false = let Firebase choose (Play Integrity first, reCAPTCHA fallback) — works on physical devices
# true  = force reCAPTCHA — only needed for release APKs sideloaded outside Play Store
FIREBASE_FORCE_RECAPTCHA=false

# Set to TRUE only when testing with Firebase Console test phone numbers
# WARNING: When TRUE, real SMS OTP will NOT work (reCAPTCHA is required for real numbers)
FIREBASE_AUTH_DISABLE_APP_VERIFICATION=false
