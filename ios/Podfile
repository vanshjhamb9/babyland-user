platform :ios, '15.0'

ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. Run `flutter pub get` first."
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}."
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

# Agora Iris FFI requires dynamic frameworks in TestFlight/App Store builds.
# See: https://github.com/AgoraIO-Extensions/Agora-Flutter-SDK/issues/2255
dynamic_frameworks = ['agora_rtc_engine', 'iris_method_channel']

pre_install do |installer|
  Pod::Installer::Xcode::TargetValidator.send(
    :define_method,
    :verify_no_static_framework_transitive_dependencies,
  ) {}

  installer.pod_targets.each do |target|
    next unless dynamic_frameworks.include?(target.name)

    puts "[Babyland] Forcing dynamic framework: #{target.name}"
    def target.build_type
      Pod::BuildType.dynamic_framework
    end
  end
end

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= [
        '$(inherited)',
        'PERMISSION_CAMERA=1',
        'PERMISSION_MICROPHONE=1',
        'PERMISSION_SPEECH_RECOGNIZER=1',
        'PERMISSION_PHOTOS=1',
        'PERMISSION_BLUETOOTH=1',
      ]
    end
  end

  pods_root = installer.sandbox.root.to_s

  # Best-effort force_load of known Agora binaries that may carry Iris FFI symbols.
  # Do NOT fail pod install if nm cannot see Iris_InitDartApiDL yet — that symbol
  # is often only verified after the IPA is linked (Codemagic IPA gate).
  force_candidates = []
  force_candidates += Dir.glob(File.join(pods_root, 'AgoraRtcEngine_iOS', 'AgoraRtcKit.xcframework', 'ios-arm64*', 'AgoraRtcKit.framework', 'AgoraRtcKit'))
  force_candidates += Dir.glob(File.join(pods_root, 'AgoraIrisRTC_iOS', '**', 'AgoraRtcWrapper.framework', 'AgoraRtcWrapper'))
  force_candidates += Dir.glob(File.join(pods_root, 'AgoraIrisRTC_iOS', '**', 'AgoraRtcWrapper'))
  force_candidates.select! { |p| File.file?(p) }
  force_candidates.uniq!

  force_load_flags = force_candidates.map do |abs|
    rel = abs.sub(%r{^#{Regexp.escape(pods_root)}/?}, '')
    "-force_load $(PODS_ROOT)/#{rel}"
  end

  if force_load_flags.empty?
    puts '[Babyland] WARNING: No AgoraRtcKit/AgoraRtcWrapper binaries found for force_load'
  else
    puts "[Babyland] Agora force_load candidates (#{force_load_flags.length}):"
    force_load_flags.each { |f| puts "  #{f}" }
  end

  installer.aggregate_targets.each do |aggregate_target|
    aggregate_target.user_project.targets.each do |target|
      next unless target.name == 'Runner'
      target.build_configurations.each do |config|
        if config.name == 'Release' || config.name == 'Profile'
          config.build_settings['STRIP_STYLE'] = 'non-global'
          config.build_settings['DEPLOYMENT_POSTPROCESSING'] = 'YES'
          config.build_settings['DEAD_CODE_STRIPPING'] = 'NO'
        end

        flags = config.build_settings['OTHER_LDFLAGS'] || ['$(inherited)']
        flags = [flags] unless flags.is_a?(Array)
        flags << '-ObjC' unless flags.any? { |f| f.to_s.include?('-ObjC') }
        flags << '-lc++' unless flags.any? { |f| f.to_s.include?('-lc++') }
        force_load_flags.each do |force|
          flags << force unless flags.any? { |f| f.to_s == force }
        end
        config.build_settings['OTHER_LDFLAGS'] = flags
      end
    end
    aggregate_target.user_project.save
  end
end
