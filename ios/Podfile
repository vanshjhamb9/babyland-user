platform :ios, '15.0'

ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. Run `flutter pub get` first."
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}."
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

# Agora Iris FFI requires dynamic frameworks in TestFlight/App Store builds.
# Static linkage strips Iris_InitDartApiDL and crashes on RtcEngine.initialize().
# See: https://github.com/AgoraIO-Extensions/Agora-Flutter-SDK/issues/2255
dynamic_frameworks = ['agora_rtc_engine', 'iris_method_channel']

pre_install do |installer|
  Pod::Installer::Xcode::TargetValidator.send(
    :define_method,
    :verify_no_static_framework_transitive_dependencies,
  ) {}

  installer.pod_targets.each do |target|
    next unless dynamic_frameworks.include?(target.name)

    puts "[Babyland] Forcing dynamic framework: #{target.name}"
    def target.build_type
      Pod::BuildType.dynamic_framework
    end
  end
end

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

def babyland_nm_tool
  %w[llvm-nm nm].find { |t| system("command -v #{t} >/dev/null 2>&1") }
end

# Returns absolute paths of Mach-O binaries under Pods that export Iris_InitDartApiDL.
def babyland_find_iris_symbol_binaries(pods_root)
  nm = babyland_nm_tool
  raise '[Babyland] ERROR: nm/llvm-nm not found — cannot verify Iris_InitDartApiDL' if nm.nil?

  hits = []
  globs = [
    File.join(pods_root, '**', '*.framework', '*'),
    File.join(pods_root, '**', '*.a'),
    File.join(pods_root, '**', '*.dylib'),
  ]
  candidates = globs.flat_map { |g| Dir.glob(g) }.select do |p|
    next false unless File.file?(p)
    next false if p.include?('/Headers/')
    next false if p.include?('.swiftmodule')
    base = File.basename(p)
    p.end_with?('.a', '.dylib') ||
      (File.extname(base).empty? && p.include?('.framework/') &&
        base == File.basename(File.dirname(p), '.framework'))
  end

  # Prefer device arm64 slices over simulator.
  device = candidates.reject { |p| p.include?('simulator') || p.include?('x86_64') }
  scan_list = device.empty? ? candidates : device

  scan_list.uniq.each do |bin|
    out = `#{nm} -gU #{Shellwords.escape(bin)} 2>/dev/null`
    if out.include?('Iris_InitDartApiDL') || out.match?(/\bInitDartApiDL\b/)
      hits << bin
      puts "[Babyland] Iris symbol found in: #{bin}"
    end
  end
  hits.uniq
end

post_install do |installer|
  require 'shellwords'

  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= [
        '$(inherited)',
        'PERMISSION_CAMERA=1',
        'PERMISSION_MICROPHONE=1',
        'PERMISSION_SPEECH_RECOGNIZER=1',
        'PERMISSION_PHOTOS=1',
        'PERMISSION_BLUETOOTH=1',
      ]
    end
  end

  pods_root = installer.sandbox.root.to_s
  iris_bins = babyland_find_iris_symbol_binaries(pods_root)

  # Always try classic AgoraRtcKit paths as fallback candidates for force_load.
  Dir.glob(File.join(pods_root, 'AgoraRtcEngine_iOS', 'AgoraRtcKit.xcframework', 'ios-arm64*', 'AgoraRtcKit.framework', 'AgoraRtcKit')).each do |p|
    iris_bins << p if File.file?(p)
  end
  Dir.glob(File.join(pods_root, 'AgoraIrisRTC_iOS', '**', 'AgoraRtcWrapper')).each do |p|
    iris_bins << p if File.file?(p)
  end
  iris_bins.uniq!

  # Fail closed: if we cannot locate any Iris-bearing binary, TestFlight will crash.
  verified = iris_bins.select do |bin|
    nm = babyland_nm_tool
    out = `#{nm} -gU #{Shellwords.escape(bin)} 2>/dev/null`
    out.include?('Iris_InitDartApiDL') || out.include?(' InitDartApiDL')
  end

  if verified.empty?
    raise <<~MSG
      [Babyland] ERROR: No Pods binary exports Iris_InitDartApiDL.
      Agora TestFlight builds will crash on RtcEngine.initialize().
      Check that agora_rtc_engine / AgoraIrisRTC pods installed correctly.
    MSG
  end

  force_load_flags = verified.map do |abs|
    rel = abs.sub(%r{^#{Regexp.escape(pods_root)}/?}, '')
    "-force_load $(PODS_ROOT)/#{rel}"
  end

  installer.aggregate_targets.each do |aggregate_target|
    aggregate_target.user_project.targets.each do |target|
      next unless target.name == 'Runner'
      target.build_configurations.each do |config|
        if config.name == 'Release' || config.name == 'Profile'
          config.build_settings['STRIP_STYLE'] = 'non-global'
          config.build_settings['DEPLOYMENT_POSTPROCESSING'] = 'YES'
          config.build_settings['DEAD_CODE_STRIPPING'] = 'NO'
        end

        flags = config.build_settings['OTHER_LDFLAGS'] || ['$(inherited)']
        flags = [flags] unless flags.is_a?(Array)
        flags << '-ObjC' unless flags.any? { |f| f.to_s.include?('-ObjC') }
        flags << '-lc++' unless flags.any? { |f| f.to_s.include?('-lc++') }
        force_load_flags.each do |force|
          flags << force unless flags.any? { |f| f.to_s == force }
        end
        config.build_settings['OTHER_LDFLAGS'] = flags
      end
    end
    aggregate_target.user_project.save
  end

  puts "[Babyland] Iris force_load binaries (#{verified.length}):"
  verified.each { |b| puts "  - #{b}" }
end
